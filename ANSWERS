1.def simpleDiv(dividend, divisor):
    quotient = 0
    while dividend >= divisor:
        dividend -= divisor
        quotient += 1
    return quotient

def main():
    print("--- Integer Division Simulator ---")
    dividend = int(input("Enter the dividend: "))
    divisor = int(input("Enter the divisor: "))
    
    if divisor == 0:
        print("Error: Division by zero is undefined.")
    else:
        result = simpleDiv(dividend, divisor)
        print(f"Result: {dividend} // {divisor} = {result}")

if __name__ == "__main__":
    main()
2.from graphics import *

def is_clicked(click_point, button_rect):
    """Returns True if click_point falls inside button_rect boundaries, False otherwise."""
    if click_point is None:
        return False
        
    p1 = button_rect.getP1()
    p2 = button_rect.getP2()
    
    # Establish bounding limits regardless of coordinate declaration order
    x_min, x_max = min(p1.getX(), p2.getX()), max(p1.getX(), p2.getX())
    y_min, y_max = min(p1.getY(), p2.getY()), max(p1.getY(), p2.getY())
    
    return x_min <= click_point.getX() <= x_max and y_min <= click_point.getY() <= y_max

def main():
    win = GraphWin("Button Window", 400, 400)
    
 
    button = Rectangle(Point(140, 180), Point(260, 220))
    button.setFill("lightgray")
    button.draw(win)
    
    label = Text(Point(200, 200), "Click Here")
    label.draw(win)
    
  
    valid_click = False
    while not valid_click:
        click = win.getMouse()
        if is_clicked(click, button):
            valid_click = True
            
  
    label.setText("Button Clicked!")
    button.setFill("green")
    
    win.getMouse()
    win.close()

if __name__ == "__main__":
    main()

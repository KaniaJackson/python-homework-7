    ground.setWidth(4)
    ground.draw(win)
    
    
    radius = initial_height * 0.03
    ball = Circle(Point(5, initial_height), radius)
    ball.setFill("crimson")
    ball.draw(win)
    
    height = initial_height
    
    while height >= 0.001:
       
        time.sleep(0.2)  # Control speed frame pacing
        ball.move(0, -height)
        
     
        height *= 0.60
        if height < 0.001:
            break
            
      
        time.sleep(0.2)
        ball.move(0, height)
        
   
    msg = Text(Point(5, initial_height / 2), "Simulation Complete!\nClick to exit.")
    msg.draw(win)
    win.getMouse()
    win.close()


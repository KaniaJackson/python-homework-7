    main()
5.def gcd(m, n):
    """Calculates the Greatest Common Divisor using Euclid's Algorithm (Page 232)."""
    while n != 0:
        m, n = n, m % n
    return m

def phi(n):
    """Accumulates and returns all numbers up to n-1 that are relatively prime to n."""
    rel_prime_list = []
  
    for k in range(1, n):
        if gcd(n, k) == 1:
            rel_prime_list.append(k)
    return rel_prime_list

def main():
    print("--- Euler's Totient Function Calculator ---")
    n = int(input("Enter an integer (n): "))
    
    if n <= 0:
        print("Please enter a positive integer greater than 0.")
    else:
        coprime_numbers = phi(n)
        print(f"\nPositive integers relatively prime to {n}:")
        print(coprime_numbers)
        print(f"\n𝜑({n}) = {len(coprime_numbers)}")

if __name__ == "__main__":
    main()


